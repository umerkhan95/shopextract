  "bootstrap": {
    "recognition": "Scan actual option tokens before --, skipping declared option operands even if they spell --help/--version. Root --help/--version only before command; known leaf --help before its -- is recognized. Validate command existence and unknown option spelling before bootstrap. Known root value errors/duplicates and config/env errors are bypassed by recognized help/version.",
    "priority": [
      "unknown_command_or_unknown_option_usage_error",
      "recognized_help",
      "recognized_root_version",
      "normal_validation_dispatch"
    ],
    "help_version_order": "help wins in either order",
    "error_output_routing": "First explicit root output-format occurrence controls routing if its operand is valid json/legacy, even when repetition causes E_USAGE. If absent or first operand invalid/missing, use successfully validated selected-file output_format, otherwise valid environment output_format, otherwise legacy. An invalid source still causes its defined error; fallback chooses representation only. A valid first legacy occurrence blocks all JSON fallback.",
    "no_read": "Bootstrap help/version never reads file or env; usage routing may read bounded selected config and documented env only to choose error representation, never dispatch."
  },
