  "commands": [
    {
      "command": "extract",
      "callback": "extract",
      "declarations": [
        "main.command()",
        "click.argument('url')",
        "click.option('--max', '-n', 'max_urls', default=20, help='Max product URLs to process.')",
        "click.option('--format', '-f', 'fmt', type=click.Choice(['csv', 'json']), default='json', help='Output format.')",
        "click.option('-o', '--output', 'output_path', default=None, help='Output file path.')"
      ],
      "dispatch": "asyncio.run(_extract(url, max_urls, fmt, output_path))"
    },
    {
      "command": "detect",
      "callback": "detect",
      "declarations": [
        "main.command()",
        "click.argument('url')"
      ],
      "dispatch": "asyncio.run(_detect(url))"
    },
    {
      "command": "discover",
      "callback": "discover",
      "declarations": [
        "main.command()",
        "click.argument('url')",
        "click.option('--max', '-n', 'max_urls', default=100, help='Max URLs to discover.')"
      ],
      "dispatch": "asyncio.run(_discover(url, max_urls))"
    },
    {
      "command": "compare",
      "callback": "compare",
      "declarations": [
        "main.command()",
        "click.argument('query')",
        "click.option('--stores', '-s', multiple=True, required=True, help='Store URLs to compare.')"
      ],
      "dispatch": "asyncio.run(_compare(query, list(stores)))"
    },
    {
      "command": "snapshot",
      "callback": "snapshot",
      "declarations": [
        "main.command()",
        "click.argument('url')"
      ],
      "dispatch": "asyncio.run(_snapshot(url))"
    },
    {
      "command": "changes",
      "callback": "changes",
      "declarations": [
        "main.command()",
        "click.argument('domain')"
      ],
      "dispatch": "asyncio.run(_changes(domain))"
    },
    {
      "command": "history",
      "callback": "history",
      "declarations": [
        "main.command()",
        "click.argument('domain')",
        "click.argument('product')"
      ],
      "dispatch": "asyncio.run(_history(domain, product))"
    },
    {
      "command": "analyze",
      "callback": "analyze",
      "declarations": [
        "main.command()",
