        "click.argument('file', type=click.Path(exists=True))",
        "click.option('--marketplace', '-m', default='google_shopping', type=click.Choice(['google_shopping', 'idealo', 'amazon', 'ebay']), help='Target marketplace for validation.')"
      ],
      "dispatch": "_validate_file(file, marketplace)"
    }
