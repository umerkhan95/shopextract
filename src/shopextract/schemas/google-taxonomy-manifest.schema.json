{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Google taxonomy resource manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "version",
    "locale",
    "source_url",
    "source_sha256",
    "fingerprint",
    "counts",
    "source_kind",
    "source_provenance",
    "catalog_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "namespace": {
      "const": "google:product_category"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "locale": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "roots",
        "leaves",
        "parent_links"
      ],
      "properties": {
        "categories": {
          "type": "integer",
          "minimum": 0
        },
        "roots": {
          "type": "integer",
          "minimum": 0
        },
        "leaves": {
          "type": "integer",
          "minimum": 0
        },
        "parent_links": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_kind": {
      "enum": [
        "google_txt",
        "shopify_google_snapshot"
      ]
    },
    "source_provenance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_kind",
            "source_url",
            "source_commit",
            "source_sha256",
            "derived_sha256"
          ],
          "properties": {
            "source_kind": {
              "enum": [
                "google_txt",
                "shopify_google_snapshot"
              ]
            },
            "source_url": {
              "type": "string"
            },
            "source_commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "derived_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
