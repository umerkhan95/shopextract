{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopExtract catalog",
  "x-contract-version": "1.0",
  "description": "Flat object arrays or native portable arrays; extraction result envelope data.products also accepted. Categorized native record/runtime envelopes use the native category codec; see docs/cli.md. Native codecs validate complete Product fields, Decimal tags, evidence binding and policy digest.",
  "anyOf": [
    {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "data"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "data": {
          "type": "object",
          "required": [
            "products"
          ],
          "properties": {
            "products": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "maxItems": 1000
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "categorized_products"
      ],
      "properties": {
        "categorized_products": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 1000
        },
        "config": {
          "type": "object",
          "properties": {
            "options": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "object",
                  "properties": {
                    "platform": {
                      "enum": [
                        "shopify",
                        "woocommerce",
                        "magento",
                        "bigcommerce",
                        "shopware",
                        "generic"
                      ]
                    },
                    "store_url": {
                      "type": "string"
                    },
                    "catalog": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "channel": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "locale": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "platform",
                    "store_url"
                  ],
                  "additionalProperties": false
                },
                "registry": {
                  "type": "object",
                  "properties": {
                    "namespace": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "target_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "namespace",
                    "version",
                    "target_ids"
                  ],
                  "additionalProperties": false
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rule_id": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      },
                      "selector": {
                        "type": "object",
                        "properties": {
                          "namespace": {
                            "type": "string"
                          },
                          "taxonomy_version": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "scope": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "platform": {
                                    "enum": [
                                      "shopify",
                                      "woocommerce",
                                      "magento",
                                      "bigcommerce",
                                      "shopware",
                                      "generic"
                                    ]
                                  },
                                  "store_url": {
                                    "type": "string"
                                  },
                                  "catalog": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "channel": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "locale": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "platform",
                                  "store_url"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "native_id": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "raw_label": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "raw_path": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "allow_unknown_version": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "namespace",
                          "taxonomy_version"
                        ],
                        "additionalProperties": false
                      },
                      "target_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "rule_id",
                      "version",
                      "selector",
                      "target_ids"
                    ],
                    "additionalProperties": false
                  }
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "terms": {
                      "type": "integer"
                    },
                    "relation_refs": {
                      "type": "integer"
                    },
                    "ancestry_depth": {
                      "type": "integer"
                    },
                    "record_bytes": {
                      "type": "integer"
                    },
                    "rules": {
                      "type": "integer"
                    },
                    "targets": {
                      "type": "integer"
                    },
                    "config_bytes": {
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "scope",
                "registry"
              ],
              "additionalProperties": false
            },
            "profile_bindings": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "options"
          ],
          "additionalProperties": false
        },
        "policy_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
