{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopExtract maintenance-profiles",
  "x-contract-version": "1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "text",
                "decimal",
                "mass",
                "volume",
                "length"
              ]
            },
            "role": {
              "enum": [
                "comparable",
                "identity_variant",
                "price_context"
              ]
            },
            "normalization": {
              "enum": [
                "exact",
                "decimal",
                "mass_kg",
                "volume_total_l_v1",
                "length_width_m_v1",
                "length_height_m_v1",
                "length_depth_m_v1"
              ]
            }
          },
          "required": [
            "kind",
            "role"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "volume"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "enum": [
                      "volume_total_l_v1"
                    ]
                  }
                },
                "required": [
                  "normalization"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "length"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "normalization": {
                    "enum": [
                      "length_width_m_v1",
                      "length_height_m_v1",
                      "length_depth_m_v1"
                    ]
                  }
                },
                "required": [
                  "normalization"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "profiles"
  ],
  "additionalProperties": false
}
