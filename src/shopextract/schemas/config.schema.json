{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShopExtract CLI config v1",
  "x-contract-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "output_format": {
      "enum": [
        "legacy",
        "json"
      ]
    },
    "diagnostics": {
      "enum": [
        "normal",
        "quiet"
      ]
    }
  }
}
